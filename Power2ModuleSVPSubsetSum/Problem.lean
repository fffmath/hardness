import Power2ModuleSVP.Problem

/-!
# Problem

Exact decision SVP in the coefficient maximum norm for full-rank free rank-two modules over
`ℤ[X]/(X^n + 1)`, `n` a power of two, with an arbitrary binary radius `T`.

An input stores the degree in unary, the two module generators as columns
`((g₁₁, g₂₁), (g₁₂, g₂₂))` of signed-binary coefficient arrays, and the radius `T` in binary.
Malformed inputs (non-dyadic degree, wrong lengths, `det G = 0`) are rejected.
The language asks for a nonzero module vector of coefficient max norm at most `T`, i.e.
`λ₁,∞(Λ(G)) ≤ T`.

Paper: `paper/power2svp-subsetsum.pdf`, Definition 2.1 and Theorem 1.1.
-/
namespace Power2ModuleSVPSubsetSum
open Turing.MultiTapeTM
open Power2ModuleSVP (Coeff Dyadic pairSup moduleVector)

/-- Stored degree, two rank-two module generators (as columns), and the binary radius. -/
abbrev SVPInput := IdealCVP.PairRingArgs × ℕ

/-- Binary encoding of an input: the Power2ModuleSVP module encoding paired with a binary
radius. -/
def encSVP : SVPInput ↪ List Bool := encPair IdealCVP.encPairRingArgs encNat

/-- The module generated by the two columns contains a nonzero vector of coefficient max norm
at most `T`. -/
def ModuleYes {d : ℕ} (a b : Coeff d × Coeff d) (T : ℕ) : Prop :=
  ∃ u v : Coeff d, moduleVector a b u v ≠ 0 ∧ pairSup (moduleVector a b u v) ≤ T

/-- A dyadic input with exact-length arrays and independent module generators
(`det G ≠ 0`). -/
def SVPInput.WellFormed (x : SVPInput) : Prop :=
  Power2ModuleSVP.SVPInput.WellFormed x.1

/-- The encoded exact maximum-norm rank-two module SVP decision language. -/
def ModuleSVPLang : Set SVPInput := {x | SVPInput.WellFormed x ∧
  ModuleYes
    (IdealCVP.ofList (d := x.1.1) x.1.2.1.1, IdealCVP.ofList (d := x.1.1) x.1.2.1.2)
    (IdealCVP.ofList (d := x.1.1) x.1.2.2.1, IdealCVP.ofList (d := x.1.1) x.1.2.2.2) x.2}

end Power2ModuleSVPSubsetSum
