import IdealCVP.Dimensions
import Mathlib.Data.Matrix.Mul

/-! # Integer certificates and executable reduction data

These are verifier and witness bounds, without a complexity-class or machine
runtime assertion. For the produced instances the multiplication-basis witness
has only zero and one coefficients.
-/
namespace IdealCVP
open IdealCVP.Cyclotomic

/-- The lattice generated by the columns of an integer matrix. -/
def matrixMap {m n : ℕ} (B : Matrix (Fin m) (Fin n) ℤ) : Coeff n →+ Coeff m where
  toFun x := B.mulVec x
  map_zero' := Matrix.mulVec_zero B
  map_add' := Matrix.mulVec_add B

/-- The additive image of the integer matrix, viewed as a coefficient lattice. -/
def matrixLattice {m n : ℕ} (B : Matrix (Fin m) (Fin n) ℤ) : AddSubgroup (Coeff m) :=
  (matrixMap B).range

/-- A computable verifier for a supplied integer coefficient certificate. -/
def verify {m n : ℕ} (B : Matrix (Fin m) (Fin n) ℤ)
    (t : Coeff m) (Δ : ℤ) (x : Coeff n) : Bool :=
  decide (sqNorm (B.mulVec x - t) ≤ Δ)

/-- The executable verifier accepts precisely the certificates within the threshold. -/
theorem verify_eq_true {m n : ℕ} (B : Matrix (Fin m) (Fin n) ℤ)
    (t : Coeff m) (Δ : ℤ) (x : Coeff n) :
    verify B t Δ x = true ↔ sqNorm (B.mulVec x - t) ≤ Δ := by
  exact decide_eq_true_iff

/-- Certificate form of exact CVP for an integer matrix lattice. -/
theorem matrix_cvp_iff {m n : ℕ} (B : Matrix (Fin m) (Fin n) ℤ)
    (t : Coeff m) (Δ : ℤ) :
    CVPYes (matrixLattice B) t Δ ↔ ∃ x : Coeff n, sqNorm (B.mulVec x - t) ≤ Δ := by
  constructor
  · rintro ⟨v, ⟨x, rfl⟩, hx⟩
    exact ⟨x, hx⟩
  · rintro ⟨x, hx⟩
    exact ⟨B.mulVec x, ⟨x, rfl⟩, hx⟩

/-- The executable multiplication matrix, with the standard monomial columns. -/
def multiplicationMatrix {d : ℕ} (g : R d) : Matrix (Fin d) (Fin d) ℤ :=
  fun i j => mul g (monomial j 1) i

/-- The monomial multiplication matrix computes negacyclic multiplication. -/
theorem multiplicationMatrix_mulVec {d : ℕ} (g x : R d) :
    (multiplicationMatrix g).mulVec x = mul g x := by
  have hx : (∑ j, x j • monomial j 1) = x := by
    funext i
    simp [monomial, Finset.sum_apply]
  conv_rhs => rw [← hx, mul_sum_right]
  simp only [mul_smul_right]
  funext i
  simp only [Matrix.mulVec, dotProduct, multiplicationMatrix, Finset.sum_apply,
    Pi.smul_apply, smul_eq_mul]
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- The multiplication matrix generates precisely the principal ideal lattice. -/
theorem matrixLattice_multiplication {d : ℕ} (g : R d) :
    matrixLattice (multiplicationMatrix g) = principalIdealLattice g := by
  ext v
  simp only [matrixLattice, AddMonoidHom.mem_range, matrixMap, AddMonoidHom.coe_mk,
    ZeroHom.coe_mk, multiplicationMatrix_mulVec, mem_principalIdealLattice]

namespace ReductionData
variable {M n : ℕ} (D : ReductionData M n)

/-- Sparse Boolean representatives have Boolean coefficients at every position. -/
theorem a_coeff_bounds (ξ : Fin n → Bool) (i : Fin D.N) :
    0 ≤ D.a ξ i ∧ D.a ξ i ≤ 1 := by
  classical
  by_cases hi : ∃ j, D.alpha j = i
  · obtain ⟨j, rfl⟩ := hi
    rw [a, sparse_at D.alpha_injective]
    exact ⟨bit_nonneg _, bit_le_one _⟩
  · have hh : ∀ j, i ≠ D.alpha j := by simpa [eq_comm] using hi
    simp only [a, sparse_apply, hh, ite_false, Finset.sum_const_zero]
    omega

/-- The actual quotient certificate uses only zero and one entries. -/
theorem encode_coeff_bounds (ξ : Fin n → Bool) (i : Fin D.d) :
    0 ≤ D.encode ξ i ∧ D.encode ξ i ≤ 1 := by
  unfold encode interleave
  split_ifs
  · exact D.a_coeff_bounds ξ _
  · change 0 ≤ (0 : ℤ) ∧ (0 : ℤ) ≤ 1
    omega

end ReductionData

/-- Explicit bounded certificates for every produced YES instance. No general
polynomial certificate bound for arbitrary integer matrices is asserted. -/
theorem x3c_bounded_certificate (I : X3CInstance) :
    I.HasExactCover ↔ ∃ x : Coeff (x3cToCVP I).d,
      (∀ i, 0 ≤ x i ∧ x i ≤ 1) ∧
      verify (multiplicationMatrix (x3cToCVP I).g) (x3cToCVP I).T (x3cToCVP I).Δ x = true := by
  dsimp only [x3cToCVP]
  constructor
  · rintro ⟨s, hs⟩
    let ξ := I.selectionEquiv s
    have hf : I.reductionData.system.Feasible ξ := (I.cover_iff_feasible s).mp hs
    refine ⟨I.reductionData.encode ξ, I.reductionData.encode_coeff_bounds ξ, ?_⟩
    rw [verify_eq_true, multiplicationMatrix_mulVec]
    exact (I.reductionData.within_threshold_iff _).mpr ⟨ξ, hf, rfl⟩
  · rintro ⟨x, _, hx⟩
    rw [verify_eq_true, multiplicationMatrix_mulVec] at hx
    exact (x3c_correct I).mpr ⟨mul (x3cToCVP I).g x, ⟨x, rfl⟩, hx⟩

end IdealCVP
